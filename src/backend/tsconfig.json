{
  "compilerOptions": {
    "baseUrl": "./",
    "outDir": "../../build",
    "paths": { "@/*": ["./*"], "@shared/*": ["../shared/*"] },
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "plugins": [{ "transform": "typescript-transform-paths" }]
  },
  "extends": "../../tsconfig.json",
  "include": ["**/*.ts", "index.mts"]
}
