{
  "name": "cardgamesimulator",
  "version": "0.0.1",
  "description": "Play card games with friends",
  "engines": {
    "node": ">=18 <=24",
    "npm": ">=9 <=10.9.2"
  },
  "scripts": {
    "start": "npm run clean && npm run lint:fix && npm run build && npm run start:backend",
    "start:backend": "node build/backend/index.js",
    "start:backend-debug": "DEBUG=express:* node build/backend/index.js",
    "build": "npm run build:backend && npm run build:frontend",
    "build:frontend": "vue-tsc --build src/frontend/tsconfig.json --noEmit && vite build",
    "build:backend": "tspc --build src/backend/tsconfig.json",
    "dev": "npm run build:backend && concurrently \"npm:start:backend\" \"vite --host\"",
    "preview": "vite preview",
    "clean": "rm -rf ./build",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:all": "npm test && npm run test:integration",
    "test:e2e": "npx playwright test",
    "test:e2e:ui": "npx playwright test --ui",
    "test:e2e:debug": "npx playwright test --debug",
    "lint:check": "eslint src --ext ts --ext vue",
    "lint:fix": "eslint --fix src --ext ts --ext vue",
    "verify:drift": "node scripts/verify-drift.mjs",
    "verify:no-destructive-ddl": "node scripts/verify-no-destructive-ddl.mjs",
    "verify:postconditions": "node scripts/verify-postconditions.mjs",
    "feedback": "node scripts/feedback.mjs",
    "errors": "node scripts/errors.mjs",
    "postinstall": "git config core.hooksPath .githooks"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/harennon/cardgamesimulator.git"
  },
  "author": "Neil Jurling",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/harennon/cardgamesimulator/issues"
  },
  "homepage": "https://github.com/harennon/cardgamesimulator#readme",
  "devDependencies": {
    "@eslint/js": "^9.22.0",
    "@playwright/test": "^1.60.0",
    "@sentry/vite-plugin": "^5.4.0",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/morgan": "^1.9.9",
    "@types/pg": "^8.20.0",
    "@types/supertest": "^7.2.0",
    "@vitejs/plugin-vue": "^5.2.3",
    "concurrently": "^10.0.3",
    "eslint": "^9.22.0",
    "eslint-plugin-vue": "^10.0.0",
    "globals": "^16.0.0",
    "pg": "^8.22.0",
    "prettier": "^3.8.3",
    "supertest": "^7.2.2",
    "ts-node": "^10.9.2",
    "ts-patch": "^3.3.0",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.26.1",
    "typescript-transform-paths": "^3.5.5",
    "vite": "^6.2.2",
    "vite-plugin-vue-devtools": "^7.7.2",
    "vitest": "^4.1.8",
    "vue-tsc": "^2.2.8"
  },
  "dependencies": {
    "@sentry/vue": "^10.65.0",
    "@supabase/supabase-js": "^2.107.0",
    "axios": "^1.8.4",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^5.0.1",
    "helmet": "^8.1.0",
    "jose": "^6.2.3",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "pino": "^10.3.1",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3",
    "vue": "^3.5.13",
    "vue-router": "^4.5.0"
  }
}
